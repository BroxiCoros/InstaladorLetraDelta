<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InstaladorLetraDelta.MainWindow"
        Title="Instalador LetraDelta"
        Width="640" Height="520"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

  <DockPanel Margin="28">

    <!-- Cabecera común a todas las páginas -->
    <StackPanel DockPanel.Dock="Top" Spacing="4">
      <TextBlock x:Name="TituloPagina" FontSize="22" FontWeight="SemiBold" />
      <TextBlock x:Name="SubtituloPagina" FontSize="13" Opacity="0.7" TextWrapping="Wrap" />
      <Separator Margin="0,12,0,0" />
    </StackPanel>

    <!-- Botonera -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="10" Margin="0,18,0,0">
      <Button x:Name="BotonCancelar" Content="Cancelar" Width="110" Click="AlCancelar" />
      <Button x:Name="BotonAtras" Content="Atrás" Width="110" Click="AlAtras" />
      <Button x:Name="BotonSiguiente" Content="Siguiente" Width="110"
              IsDefault="True" Click="AlSiguiente" />
    </StackPanel>

    <Panel Margin="0,18,0,0">

      <!-- 1. Bienvenida -->
      <StackPanel x:Name="PaginaBienvenida" Spacing="10">
        <TextBlock Text="Este asistente instalará la traducción al español americano de DELTARUNE."
                   TextWrapping="Wrap" />
        <TextBlock Text="La instalación incluye:" Margin="0,6,0,0" />
        <StackPanel Margin="12,0,0,0" Spacing="3">
          <TextBlock Text="• Mod de «Deltranslate»" />
          <TextBlock Text="• Traducción completa de los capítulos 1 a 5" />
          <TextBlock Text="• El inglés original, para poder alternar desde el menú del juego" />
        </StackPanel>
        <TextBlock Text="La traducción se aplicará sobre tu instalación actual del juego. Las partidas guardadas no se verán afectadas."
                   TextWrapping="Wrap" Margin="0,6,0,0" />
        <Border CornerRadius="4" Padding="10" Margin="0,4,0,0" BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
          <StackPanel Spacing="4">
            <TextBlock Text="Antes de empezar" FontWeight="SemiBold" />
            <TextBlock Text="Debe ser una copia limpia del juego, sin otros parches ni traducciones instalados antes. Si ya habías aplicado alguno, o no lo recuerdas, verifica la integridad de los archivos en Steam antes de continuar."
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <TextBlock Text="En Linux el juego funciona con Proton, pero los archivos del juego son los mismos que en Windows y el parche se aplica igual."
                   TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="0,2,0,0" />
      </StackPanel>

      <!-- 2. Opciones -->
      <StackPanel x:Name="PaginaOpciones" Spacing="6" IsVisible="False">
        <CheckBox x:Name="CasillaBordes" Content="Instalar versión con bordes (NXRUNE)" />
        <TextBlock Text="Añade los bordes decorativos de las versiones de consola. Variante visual basada en NXRUNE."
                   TextWrapping="Wrap" Margin="26,0,0,0" Opacity="0.7" FontSize="12" />
      </StackPanel>

      <!-- 3. Carpeta del juego -->
      <StackPanel x:Name="PaginaCarpeta" Spacing="10" IsVisible="False">
        <TextBlock Text="Selecciona la carpeta que contiene «DELTARUNE.exe» y las carpetas «chapter1_windows» … «chapter5_windows»."
                   TextWrapping="Wrap" />
        <DockPanel Margin="0,6,0,0">
          <Button DockPanel.Dock="Right" Content="Examinar…" Width="110" Margin="8,0,0,0"
                  Click="AlExaminar" />
          <TextBox x:Name="CampoCarpeta" TextChanged="AlCambiarCarpeta" />
        </DockPanel>
        <TextBlock x:Name="AvisoCarpeta" TextWrapping="Wrap" FontSize="12" />
      </StackPanel>

      <!-- 4. Progreso y resultado -->
      <StackPanel x:Name="PaginaProgreso" Spacing="12" IsVisible="False">
        <TextBlock x:Name="TextoProgreso" TextWrapping="Wrap" />
        <ProgressBar x:Name="BarraProgreso" Height="6" Minimum="0" Maximum="100" />
        <Border x:Name="CajaDetalle" IsVisible="False" CornerRadius="4" Padding="10"
                BorderThickness="1" MaxHeight="240"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <SelectableTextBlock x:Name="TextoDetalle" FontFamily="monospace" FontSize="11"
                                 TextWrapping="Wrap" />
          </ScrollViewer>
        </Border>
      </StackPanel>

    </Panel>
  </DockPanel>
</Window>
