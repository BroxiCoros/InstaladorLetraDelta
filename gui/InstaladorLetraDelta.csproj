<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WinExe también en Linux: evita que se abra una terminal detrás de la
         ventana cuando se lanza con doble clic desde el escritorio. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>InstaladorLetraDelta</AssemblyName>
    <RootNamespace>InstaladorLetraDelta</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>

    <!-- Tanto el AppImage como el paquete de macOS traen dentro su propio
         runtime, así que se publica autocontenido pero sin archivo único:
         dentro del paquete no aporta nada y complica la depuración.

         El RID lo fija el script de empaquetado de cada plataforma; aquí solo
         se declara la lista y un valor por defecto para compilar en local. -->
    <RuntimeIdentifiers>linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' AND $([MSBuild]::IsOSPlatform('OSX'))">osx-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>

    <NeutralLanguage>es</NeutralLanguage>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Se mantiene alineada con AppVersion de setup.iss. -->
    <Version>1.5.1</Version>
    <Product>Instalador LetraDelta</Product>
    <CompanyName>BroxiCoros</CompanyName>
    <Copyright>Copyright 2026 BroxiCoros</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- El icono de la ventana y el logo de la cabecera. Son PNG derivados de
         icon.ico y logo.bmp, que usa Inno Setup: van versionados en vez de
         generarse al compilar, por el mismo motivo que packaging/macos/icono-1024.png
         (no depender de ImageMagick, y que el resultado no cambie sin querer). -->
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
  </ItemGroup>
</Project>
