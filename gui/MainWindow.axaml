<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InstaladorLetraDelta.MainWindow"
        Title="Instalador LetraDelta"
        Icon="/Assets/icono.png"
        Width="640" Height="520"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

  <DockPanel Margin="28">

    <!-- Cabecera común a todas las páginas.
         El logo va recortado en un cuadrado redondeado a propósito: el arte
         tiene el fondo negro opaco, así que como baldosa se lee igual de bien
         en tema claro y en oscuro, mientras que recortarle el negro dejaría
         agujeros dentro del propio dibujo. -->
    <StackPanel DockPanel.Dock="Top">
      <DockPanel>
        <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="10"
                ClipToBounds="True" Margin="0,0,14,0" VerticalAlignment="Top"
                BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
          <Image Source="/Assets/logo.png" Width="48" Height="48" />
        </Border>
        <StackPanel VerticalAlignment="Center" Spacing="3">
          <TextBlock x:Name="TituloPagina" FontSize="20" FontWeight="SemiBold"
                     TextWrapping="Wrap" />
          <TextBlock x:Name="SubtituloPagina" FontSize="13" Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>
      <Separator Margin="0,12,0,0" />
    </StackPanel>

    <!-- Botonera, con la versión a la izquierda: siempre visible, para que se
         sepa de qué versión se habla al pedir o dar soporte. -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
      <TextBlock x:Name="EtiquetaVersion" DockPanel.Dock="Left"
                 VerticalAlignment="Center" FontSize="11" Opacity="0.5" />
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right" Spacing="10">
        <Button x:Name="BotonCancelar" Content="Cancelar" Width="110" Click="AlCancelar" />
        <Button x:Name="BotonAtras" Content="Atrás" Width="110" Click="AlAtras" />
        <Button x:Name="BotonSiguiente" Content="Siguiente" Width="110"
                IsDefault="True" Click="AlSiguiente" />
      </StackPanel>
    </DockPanel>

    <Panel Margin="0,18,0,0">

      <!-- 1. Bienvenida -->
      <StackPanel x:Name="PaginaBienvenida" Spacing="10">
        <TextBlock Text="Este asistente instalará la traducción al español americano de DELTARUNE."
                   TextWrapping="Wrap" />
        <TextBlock Text="La instalación incluye:" Margin="0,6,0,0" />
        <StackPanel Margin="12,0,0,0" Spacing="3">
          <TextBlock Text="• Mod de «Deltranslate»" />
          <TextBlock Text="• Traducción completa de los capítulos 1 a 5" />
        </StackPanel>
        <TextBlock Text="La traducción se aplicará sobre tu instalación actual del juego. Las partidas guardadas no se verán afectadas."
                   TextWrapping="Wrap" Margin="0,6,0,0" />
        <TextBlock x:Name="NotaPlataforma"
                   TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="0,2,0,0" />
      </StackPanel>

      <!-- 2. Antes de empezar
           Tiene página propia, igual que en el instalador de Windows (wpClean
           en setup.iss). Estuvo metida en un recuadro de la bienvenida, y ahí
           compartía pantalla con el resto del texto y se pasaba por alto: es
           el aviso que evita parchear un juego ya parcheado, que produce un
           resultado corrupto SIN QUE EL PARCHEADOR SE QUEJE. -->
      <StackPanel x:Name="PaginaLimpieza" Spacing="10" IsVisible="False">
        <TextBlock Text="La traducción debe aplicarse sobre una copia limpia del juego, sin otros parches ni traducciones instalados antes."
                   TextWrapping="Wrap" />
        <TextBlock Text="Si ya habías aplicado algún parche, o no lo recuerdas, verifica la integridad de los archivos en Steam antes de continuar:"
                   TextWrapping="Wrap" Margin="0,6,0,0" />
        <Border CornerRadius="4" Padding="10" BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
          <TextBlock Text="Clic derecho sobre DELTARUNE → «Propiedades» → «Archivos instalados» → «Verificar la integridad de los archivos del juego»"
                     TextWrapping="Wrap" />
        </Border>
        <TextBlock Text="Steam restaura los originales y la instalación parte de cero."
                   TextWrapping="Wrap" />
        <TextBlock x:Name="AvisoInstalacionPrevia" TextWrapping="Wrap" FontSize="12"
                   IsVisible="False" Margin="0,6,0,0" />
      </StackPanel>

      <!-- 3. Opciones -->
      <StackPanel x:Name="PaginaOpciones" Spacing="6" IsVisible="False">
        <CheckBox x:Name="CasillaBordes" Content="Instalar versión con bordes (NXRUNE)" />
        <TextBlock Text="Añade los bordes decorativos de las versiones de consola. Variante visual basada en NXRUNE."
                   TextWrapping="Wrap" Margin="26,0,0,0" Opacity="0.7" FontSize="12" />
      </StackPanel>

      <!-- 4. Carpeta del juego -->
      <StackPanel x:Name="PaginaCarpeta" Spacing="10" IsVisible="False">
        <TextBlock x:Name="AyudaCarpeta" TextWrapping="Wrap" />
        <DockPanel Margin="0,6,0,0">
          <Button DockPanel.Dock="Right" Content="Examinar…" Width="110" Margin="8,0,0,0"
                  Click="AlExaminar" />
          <TextBox x:Name="CampoCarpeta" TextChanged="AlCambiarCarpeta" />
        </DockPanel>
        <TextBlock x:Name="AvisoCarpeta" TextWrapping="Wrap" FontSize="12" />
      </StackPanel>

      <!-- 5. Progreso y resultado -->
      <StackPanel x:Name="PaginaProgreso" Spacing="12" IsVisible="False">
        <TextBlock x:Name="TextoProgreso" TextWrapping="Wrap" />
        <ProgressBar x:Name="BarraProgreso" Height="6" Minimum="0" Maximum="100" />
        <Border x:Name="CajaDetalle" IsVisible="False" CornerRadius="4" Padding="10"
                BorderThickness="1" MaxHeight="240"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <SelectableTextBlock x:Name="TextoDetalle" FontFamily="monospace" FontSize="11"
                                 TextWrapping="Wrap" />
          </ScrollViewer>
        </Border>
      </StackPanel>

    </Panel>
  </DockPanel>
</Window>
