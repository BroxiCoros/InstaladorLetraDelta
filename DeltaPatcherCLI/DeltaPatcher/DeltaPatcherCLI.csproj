<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <DebugType>embedded</DebugType>
    <!-- Idioma neutral del binario: español. Si se forkea para otro idioma,
         cambiar aquí, en LocalizedText.cs y en setup.iss. -->
    <NeutralLanguage>es</NeutralLanguage>
    <ResourceLanguages>es</ResourceLanguages>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup>
    <Version>1.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>LetraDelta Patcher CLI</Product>
    <AssemblyTitle>DeltaPatcherCLI</AssemblyTitle>
    <CompanyName>BroxiCoros</CompanyName>
    <Copyright>Copyright 2026 BroxiCoros (fork de DeltaPatcherCLI por LazyDesman, 2025)</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- Debe ir en la misma version que la que arrastra UndertaleModLib, o el
         restore falla con NU1107 por conflicto en CodeAnalysis.Scripting.Common. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UndertaleModTool\Underanalyzer\Underanalyzer\Underanalyzer.csproj" />
    <ProjectReference Include="..\UndertaleModTool\UndertaleModLib\UndertaleModLib.csproj" />
    <TrimmerRootAssembly Include="Underanalyzer" />
    <TrimmerRootAssembly Include="UndertaleModLib" />
    <!-- Los scripts del mod acceden a ScriptGlobals por reflexion (SyncBinding,
         MainThreadAction...). Sin enraizar este ensamblado el trimmer borra los
         miembros que nadie referencia estaticamente y las busquedas devuelven
         null en silencio. -->
    <TrimmerRootAssembly Include="DeltaPatcherCLI" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="LocalizedText.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Remove="apktool.jar" />
    <EmbeddedResource Include="apktool.jar" />
  </ItemGroup>

  <!-- GameSpecificData son las definiciones que Underanalyzer usa para resolver
       constantes a nombres de asset al decompilar (snd_*, spr_*, c_white...).
       UndertaleModLib las marca ExcludeFromSingleFile=true, pensadas para vivir
       sueltas junto al .exe; en un publish single-file eso las deja fuera y
       GameSpecificResolver (que las busca en AppContext.BaseDirectory) no las
       encuentra.

       Sin ellas el decompilador emite el id crudo (`107` en vez de
       `snd_flowery_voicenoise_1`) y los reemplazos por regex de los manifiestos
       del mod (CodesWithSounds.json, CodesWithSprites.json...) no encuentran el
       nombre y se saltan EN SILENCIO, dejando un data.win a medio parchear que
       el patcher reporta como correcto.

       Forzamos ExcludeFromSingleFile=false para que se empaqueten dentro del
       binario; IncludeAllContentForSelfExtract (arriba) las extrae junto a la
       app al arrancar, que es justo donde el resolver mira. -->
  <Target Name="EmbedGameSpecificData" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
                             Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('GameSpecificData'))"
                             ExcludeFromSingleFile="false" />
    </ItemGroup>
  </Target>

  <Target Name="DeleteXML" AfterTargets="AfterPublish">
    <Message Text="$(PublishDir)UndertaleModLib.xml" Importance="high" />
    <Exec Command="del /F /Q $(PublishDir)UndertaleModLib.xml" IgnoreExitCode="true" />
  </Target>

  <PropertyGroup>
    <TrimMode>copyused</TrimMode>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
</Project>
